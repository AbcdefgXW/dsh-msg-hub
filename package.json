{
  "name": "dsh-msg-hub",
  "version": "0.1.9",
  "description": "dsh IM hub: WeChat(ilinkai) / QQ / Feishu bridge with proactive push & remote monitoring",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "login:weixin": "node scripts/weixin-login.mjs",
    "monitor:weixin": "node scripts/weixin-monitor.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@tencent-connect/qqbot-connector": "^1.2.0",
    "@tencent-connect/qqbot-nodejs": "^1.0.4",
    "qrcode-terminal": "0.12.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.8.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.0-rc.8": "compatible",
        "0.1.1-rc.1": "compatible",
        "0.1.1-rc.2": "compatible"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbcdefgXW/dsh-msg-hub.git"
  },
  "homepage": "https://github.com/AbcdefgXW/dsh-msg-hub",
  "bugs": {
    "url": "https://github.com/AbcdefgXW/dsh-msg-hub/issues"
  },
  "license": "MIT",
  "files": [
    "index.js",
    "lib/",
    "scripts/",
    "dist/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "plugin",
    "im",
    "wechat",
    "qq",
    "feishu",
    "bridge",
    "push",
    "微信",
    "飞书",
    "消息桥"
  ]
}
